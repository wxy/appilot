{
  "name": "@appilot-labs/appilot",
  "version": "1.0.1",
  "description": "Appilot DeepSeek Harness plugin — App 运营 Agent 工具（项目上下文 / 发布草稿 / readiness / 文案）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:client",
    "build:client": "node ./scripts/build-client.mjs",
    "test:client:smoke": "tsx ./scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test:client:contract": "node ./scripts/contract-test.mjs",
    "test:tools": "tsx ./scripts/tool-smoke.mjs"
  },
  "dependencies": {
    "@appilot-labs/appilot-core": "^1.0.0",
    "@appilot-labs/appilot-common": "^1.0.0",
    "@appilot-labs/appilot-project": "^1.0.0",
    "@appilot-labs/appilot-release": "^1.0.0",
    "@appilot-labs/appilot-headless": "^1.0.0",
    "@appilot-labs/appilot-scheduler": "^1.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxy/appilot.git"
  }
}
