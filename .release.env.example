# 复制为 .release.env 并填写真实值（.release.env 已被 .gitignore 忽略，切勿提交）。
# CSC_LINK 用 .p12 文件路径即可（electron-builder 支持路径，不必 base64 内嵌私钥）。
export CSC_LINK="/absolute/path/to/DevID.p12"
export CSC_KEY_PASSWORD="p12 导出时设置的密码"
export APPLE_ID="you@apple.com"
export APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"
export APPLE_TEAM_ID="ABCDE12345"
