{
  "name": "@appilot-labs/appilot-mcp",
  "version": "1.0.1",
  "description": "Appilot MCP stdio server — 把 headless 服务 API（项目/快照/任务）暴露为标准 MCP 工具，供 Claude Desktop / Cursor 等客户端调用。",
  "bin": {
    "appilot-mcp": "./dist/mcp.js"
  },
  "main": "./dist/mcp.js",
  "types": "./dist/mcp.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@appilot-labs/appilot-headless": "^1.0.0",
    "@appilot-labs/appilot-scheduler": "^1.0.0"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
