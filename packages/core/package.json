{
  "name": "@appilot-labs/appilot-core",
  "version": "1.0.1",
  "description": "Appilot core engine — pure TypeScript, zero Electron/React/Cordis dependency",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx tests/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "openai": "^6.47.0"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
