{
  "name": "@appilot-labs/appilot-headless-cli",
  "version": "0.1.0",
  "description": "Appilot headless CLI——直接对接 headless 服务 API（projects/snapshots/tasks），无壳依赖。",
  "bin": {
    "appilot-headless": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx tests/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@appilot-labs/appilot-headless": "^0.1.0"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
